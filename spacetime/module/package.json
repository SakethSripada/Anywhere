{
  "name": "@anywhere/spacetime-module",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "spacetime build",
    "publish:local": "spacetime publish anywhere --server local",
    "publish:maincloud": "spacetime publish anywhere --server maincloud",
    "generate": "spacetime generate --lang typescript --out-dir ../bindings/src --module-path .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "spacetimedb": "2.14.1"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
