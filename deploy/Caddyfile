{$DOMAIN} {
	encode zstd gzip

	# Control plane API and the authenticated VNC WebSocket proxy.
	handle_path /api/* {
		# The bridge reaches the control plane over the Compose network; never from outside.
		respond /v1/bridge/* 404
		reverse_proxy control:8000 {
			# Desktop streams are long-lived.
			stream_timeout 12h
			stream_close_delay 5s
		}
	}

	# OAuth discovery for MCP clients lives at the host root (RFC 8414 / RFC 9728) and is
	# answered by the control plane, path intact.
	handle /.well-known/oauth-* {
		reverse_proxy control:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The OAuth consent page must never render inside someone else's frame.
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
}

# Self-hosted SpacetimeDB (only with --profile spacetime). Set STDB_DOMAIN in
# deploy/.env (e.g. stdb.example.com, with a DNS record pointing at this VM) and
# SPACETIME_PUBLIC_URL=wss://$STDB_DOMAIN. Unset, it defaults to an inert
# http://stdb.localhost that nothing outside the VM can reach.
#
# Only what the browser SDK uses is proxied: swapping its token for a short-lived
# WebSocket token, and the subscription socket. Publishing, SQL, logs and the
# other admin endpoints stay on the Compose network.
{$STDB_DOMAIN} {
	@sdk {
		method POST OPTIONS
		path /v1/identity/websocket-token
	}
	@subscribe {
		method GET
		path /v1/database/{$SPACETIME_DATABASE}/subscribe
	}
	handle @sdk {
		reverse_proxy spacetime:3000
	}
	handle @subscribe {
		reverse_proxy spacetime:3000 {
			stream_close_delay 5s
		}
	}
	handle {
		respond 403
	}
}
