{$DOMAIN} {
	encode zstd gzip

	# Control plane API and the authenticated VNC WebSocket proxy.
	handle_path /api/* {
		reverse_proxy control:8000 {
			# Desktop streams are long-lived.
			stream_timeout 12h
			stream_close_delay 5s
		}
	}

	# OAuth discovery for MCP clients lives at the host root (RFC 8414 / RFC 9728) and is
	# answered by the control plane, path intact.
	handle /.well-known/oauth-* {
		reverse_proxy control:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The OAuth consent page must never render inside someone else's frame.
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
}

# Self-hosted SpacetimeDB (only with --profile spacetime). Point a DNS record at
# this VM, uncomment, and set SPACETIME_PUBLIC_URL=wss://stdb.example.com.
# stdb.example.com {
