# ── Deployment ────────────────────────────────────────────────────────────
DOMAIN=anywhere.example.com

# ── SpacetimeDB ───────────────────────────────────────────────────────────
# Maincloud (free): SPACETIME_HOST=https://maincloud.spacetimedb.com
# Self-hosted (--profile spacetime): SPACETIME_HOST=http://spacetime:3000
SPACETIME_HOST=https://maincloud.spacetimedb.com
# What browsers connect to (baked into the web build).
SPACETIME_PUBLIC_URL=wss://maincloud.spacetimedb.com
SPACETIME_DATABASE=anywhere
# Control plane worker identity — `anywhere identity`, then allowlist it (see README).
SPACETIME_WORKER_TOKEN=

# ── Access & guardrails ───────────────────────────────────────────────────
INVITE_CODE=
# disabled | dry_run | live — live creates real, billed Brev instances.
PROVISIONING_MODE=disabled
GLOBAL_BUDGET_CENTS=5000
MAX_CONCURRENT_INSTANCES=1
MAX_SESSION_HOURS=4
DESKTOP_IDLE_MINUTES=20
# MCP server for external agents at https://$DOMAIN/api/mcp. Users mint tokens in Settings → Agents.
MCP_ENABLED=true
MCP_MAX_TOKENS_PER_ACCOUNT=10
MCP_MAX_TOKEN_DAYS=365

# ── NVIDIA ────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=
BREV_API_KEY=

# ── Object storage (S3-compatible: Cloudflare R2, AWS S3, MinIO) ─────────
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Photon iMessage (--profile messaging) ────────────────────────────────
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Shared secret between the bridge and the control plane: `openssl rand -hex 32`
MESSAGING_BRIDGE_SECRET=
# Optional separate worker identity for the bridge (defaults to the control plane's).
MESSAGING_SPACETIME_TOKEN=
