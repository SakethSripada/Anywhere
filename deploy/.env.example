# ── Deployment ────────────────────────────────────────────────────────────
DOMAIN=anywhere.example.com

# ── SpacetimeDB ───────────────────────────────────────────────────────────
# Maincloud (free): SPACETIME_HOST=https://maincloud.spacetimedb.com
# Self-hosted (--profile spacetime): SPACETIME_HOST=http://spacetime:3000
SPACETIME_HOST=https://maincloud.spacetimedb.com
# What browsers connect to (baked into the web build).
SPACETIME_PUBLIC_URL=wss://maincloud.spacetimedb.com
SPACETIME_DATABASE=anywhere
# Control plane worker identity — `anywhere identity`, then allowlist it (see README).
SPACETIME_WORKER_TOKEN=

# ── Control plane ─────────────────────────────────────────────────────────
# ENVIRONMENT, PUBLIC_WEB_ORIGIN, CORS_ORIGINS and DATA_DIR are set by docker-compose.yml.
LOG_LEVEL=INFO

# ── Access & guardrails ───────────────────────────────────────────────────
INVITE_CODE=
# disabled | dry_run | live — live creates real, billed Brev instances.
PROVISIONING_MODE=disabled
GLOBAL_BUDGET_CENTS=5000
MAX_CONCURRENT_INSTANCES=1
MAX_SESSION_HOURS=4
DESKTOP_IDLE_MINUTES=20
# MCP server for external agents at https://$DOMAIN/api/mcp. Users mint tokens in Settings → Agents.
MCP_ENABLED=true
MCP_MAX_TOKENS_PER_ACCOUNT=10
MCP_MAX_TOKEN_DAYS=365
# OAuth sign-in for MCP clients (claude.ai connectors). PUBLIC_API_URL is set by docker-compose.
MCP_OAUTH_ENABLED=true

# How often the guard loop accrues spend, enforces limits and reconciles instances.
BUDGET_TICK_SECONDS=30
# Largest dataset upload accepted (bytes).
MAX_UPLOAD_BYTES=2147483648

# ── NVIDIA Nemotron (build.nvidia.com) ───────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Let the vision model reason before each desktop action (slower, sometimes more accurate).
VISION_THINKING=false

# ── NVIDIA Brev ───────────────────────────────────────────────────────────
# An org API key (starts with bak-). The CLI reads it from the environment; no login step needed.
BREV_API_KEY=
BREV_BINARY=brev

# ── Desktop environment ──────────────────────────────────────────────────
DESKTOP_IMAGE=ghcr.io/trycua/linux:24.04
# Must have a checksum in supervisor.BLENDER_SHA256.
BLENDER_VERSION=4.5.15

# ── Object storage (S3-compatible: Cloudflare R2, AWS S3, MinIO) ─────────
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Photon iMessage (--profile messaging) ────────────────────────────────
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_API_BASE=https://spectrum.photon.codes
# Shared secret between the bridge and the control plane: `openssl rand -hex 32`
MESSAGING_BRIDGE_SECRET=
# Optional separate worker identity for the bridge (defaults to the control plane's).
MESSAGING_SPACETIME_TOKEN=
# How long the bridge waits for an agent turn before giving up (ms).
TURN_TIMEOUT_MS=120000
