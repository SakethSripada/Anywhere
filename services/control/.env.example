# Local development. Copy to .env (gitignored). See deploy/.env.example for every option.
ENVIRONMENT=development
SPACETIME_HOST=http://127.0.0.1:3100
SPACETIME_DATABASE=anywhere
SPACETIME_WORKER_TOKEN=
PROVISIONING_MODE=disabled
PUBLIC_WEB_ORIGIN=http://localhost:3001
# Where MCP clients reach this service (the OAuth issuer).
PUBLIC_API_URL=http://localhost:8000
NVIDIA_API_KEY=
# Defaults: PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
BREV_API_KEY=
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Path to the brev CLI if it isn't on PATH (v0.6.337 is what the image pins).
BREV_BINARY=brev
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
MESSAGING_BRIDGE_SECRET=
